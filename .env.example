# Copiar a .env y ajustar. Nunca subir .env al repositorio.

APP_ENV=local
LOG_LEVEL=debug

# API
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
# DATABASE_URL usa el rol de la aplicación (sin superusuario, sujeto a RLS).
DATABASE_URL=postgres://saas_app:saas_app@localhost:5432/saas?sslmode=disable
# MIGRATIONS_DATABASE_URL usa el rol dueño del esquema (solo para migraciones).
MIGRATIONS_DATABASE_URL=postgres://saas:saas@localhost:5432/saas?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Almacenamiento S3 (SeaweedFS en local)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=saas-local
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Correo (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025

# Auth
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
